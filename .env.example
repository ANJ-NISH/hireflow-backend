NODE_ENV="development"

# Database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/hireflow?schema=public"

# App
PORT=5000
FRONTEND_URL="http://localhost:5173"

# JWT: two different long random strings. Generate each with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Email (optional in dev; leave blank to log emails to the console instead)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="HireFlow <no-reply@hireflow.dev>"

# File storage (s3rver locally; any S3-compatible service in production)
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="S3RVER"
S3_SECRET_ACCESS_KEY="S3RVER"
S3_BUCKET="hireflow-resumes"
S3_FORCE_PATH_STYLE="true"

# Redis: queue (BullMQ) and a separate cache instance
REDIS_URL="redis://localhost:6379"
CACHE_REDIS_URL="redis://localhost:6380"

# Rate limiting and reminders
RATE_LIMIT_ENABLED="true"
TRUST_PROXY=""
INTERVIEW_REMINDER_LEAD_MINUTES=1440